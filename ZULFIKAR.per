; ------------------------------------------------------------
; 5. MEGA-BANK & DEATH MATCH (20K+ Resources / Flooded Economy)
; When resources exceed 4000 or in Death Match mode, villagers focus on
; rapid building while retaining balanced economic collection.
; ------------------------------------------------------------
(defrule
    (or (death-match-game)
    (or (wood-amount > 4000)
        (food-amount > 4000)))
=>
    (set-strategic-number sn-percent-civilian-explorers 0)
    (set-strategic-number sn-cap-civilian-explorers 0)
    (set-strategic-number sn-minimum-civilian-explorers 0)
    (set-strategic-number sn-total-number-explorers 0)
    (set-strategic-number sn-percent-civilian-builders 60)
    (set-strategic-number sn-cap-civilian-builders 100)
    (set-strategic-number sn-percent-civilian-gatherers 40)
    (set-strategic-number sn-wood-gatherer-percentage 25)
    (set-strategic-number sn-food-gatherer-percentage 25)
    (set-strategic-number sn-gold-gatherer-percentage 25)
    (set-strategic-number sn-stone-gatherer-percentage 25)
    (set-strategic-number sn-maximum-town-size 45)
    (set-strategic-number sn-safe-town-size 50)
)

(defrule
    (not (death-match-game))
    (wood-amount < 2000)
    (food-amount < 2000)
    (current-age >= imperial-age)
=>
    (set-strategic-number sn-percent-civilian-gatherers 75)
    (set-strategic-number sn-percent-civilian-builders 25)
    (set-strategic-number sn-cap-civilian-builders 16)
)

; ------------------------------------------------------------
; 6. DYNAMIC MARKET BALANCING (Human-Like Resource Trading)
; ------------------------------------------------------------

; Feudal -> Castle Age push: Click up ASAP
(defrule
    (current-age == feudal-age)
    (food-amount < 800)
    (food-amount >= 600)
    (gold-amount > 300)
    (can-buy-commodity food)
=>
    (buy-commodity food)
)

(defrule
    (current-age == feudal-age)
    (food-amount < 800)
    (wood-amount > 400)
    (gold-amount < 200)
    (can-sell-commodity wood)
=>
    (sell-commodity wood)
)

; Castle -> Imperial Age push: Click up ASAP
(defrule
    (current-age == castle-age)
    (food-amount < 1000)
    (food-amount >= 750)
    (gold-amount > 900)
    (can-buy-commodity food)
=>
    (buy-commodity food)
)

(defrule
    (current-age == castle-age)
    (gold-amount < 800)
    (wood-amount > 650)
    (can-sell-commodity wood)
=>
    (sell-commodity wood)
)

; Citadel Emergency Stone Purchase: Guarantee Castle construction!
(defrule
    (current-age >= castle-age)
    (building-type-count-total castle < 1)
    (stone-amount >= 350)
    (stone-amount < 650)
    (gold-amount > 300)
    (can-buy-commodity stone)
=>
    (buy-commodity stone)
)

; Surplus Liquidation: Sell excess wood/food for gold
(defrule
    (current-age >= feudal-age)
    (wood-amount > 800)
    (gold-amount < 250)
    (can-sell-commodity wood)
=>
    (sell-commodity wood)
)

(defrule
    (current-age >= feudal-age)
    (food-amount > 800)
    (gold-amount < 250)
    (can-sell-commodity food)
=>
    (sell-commodity food)
)

; Starvation Rescue: Buy food/wood if desperately starved
(defrule
    (current-age >= feudal-age)
    (food-amount < 100)
    (gold-amount > 350)
    (can-buy-commodity food)
=>
    (buy-commodity food)
)

(defrule
    (current-age >= feudal-age)
    (wood-amount < 100)
    (gold-amount > 350)
    (can-buy-commodity wood)
=>
    (buy-commodity wood)
)

; Surplus Stone Sale: Sell stone when fortress network complete
(defrule
    (current-age >= castle-age)
    (building-type-count-total castle >= 2)
    (stone-amount > 700)
    (gold-amount < 300)
    (can-sell-commodity stone)
=>
    (sell-commodity stone)
)

; ============================================================
; SECTION 7: DARK AGE HUMAN BUILD ORDER (The 21-Pop Standard)
; ============================================================

(defrule
    (current-age <= dark-age)
    (unit-type-count-total villager < gl-dark-age-vils)
    (can-train villager)
=>
    (train villager)
)

(defrule
    (current-age <= dark-age)
    (housing-headroom < 4)
    (population-headroom > 0)
    (not (civ-selected hun))
    (can-build house)
=>
    (build house)
)

(defrule
    (current-age <= dark-age)
    (building-type-count-total lumber-camp < 1)
    (resource-found wood)
    (can-build lumber-camp)
=>
    (build lumber-camp)
)

(defrule
    (current-age <= dark-age)
    (building-type-count-total mill < 1)
    (unit-type-count-total villager >= 10)
    (can-build mill)
=>
    (build mill)
)

; Emergency Dark Age farm only if natural food exhausted
(defrule
    (current-age <= dark-age)
    (building-type-count-total mill >= 1)
    (dropsite-min-distance hunting > 35)
    (dropsite-min-distance food > 25)
    (building-type-count-total farm < 2)
    (can-build farm)
=>
    (build farm)
)

; Barracks in late Dark Age (for open maps or non-FC styles)
(defrule
    (current-age <= dark-age)
    (goal gl-map-style style-open)
    (unit-type-count-total villager >= 19)
    (building-type-count-total barracks < 1)
    (can-build barracks)
=>
    (build barracks)
)

; Loom right before Feudal Age (or emergency)
(defrule
    (current-age <= dark-age)
    (can-research ri-loom)
    (or (unit-type-count-total villager >= 20)
        (and (unit-type-count-total villager >= 12)
             (food-amount < 50)))
=>
    (research ri-loom)
)

(defrule
    (current-age <= dark-age)
    (can-research feudal-age)
=>
    (research feudal-age)
    (chat-to-all "ZULFIKAR: Advancing to Feudal Age.")
)
