; ============================================================
; SECTION 17: PERSONALITY, HUMAN CHAT & RESIGN ETIQUETTE
; ============================================================

(defrule
    (current-age >= castle-age)
    (current-age < imperial-age)
=>
    (chat-to-all "ZULFIKAR: Castle Age reached. The fortress stands resolute.")
    (disable-self)
)

(defrule
    (current-age >= imperial-age)
=>
    (chat-to-all "ZULFIKAR: Imperial Age reached. Prepare for siege.")
    (disable-self)
)

(defrule
    (hold-relics)
=>
    (chat-to-all "ZULFIKAR: The sacred relics have been gathered.")
    (disable-self)
)

; Resign gracefully when utterly destroyed
(defrule
    (game-time > 1200)
    (unit-type-count-total villager < 1)
    (military-population < 3)
    (building-type-count-total town-center < 1)
=>
    (chat-to-all "ZULFIKAR: gg wp! Well played.")
    (resign)
)

