; ============================================================
; SECTION 2: INITIALIZATION & STRATEGIC FOUNDATIONS
; Split into modular rules with <= 12 actions to comply with
; the AoE2 engine hard limit of 16 actions per defrule.
; ============================================================

; --- Rule 1: Goals & Building Placement Setup ---
(defrule
    (true)
=>
    (set-goal gl-map-style style-open)
    (set-goal gl-map-size size-medium)
    (set-goal gl-civ-archetype archetype-balanced)
    (set-goal gl-game-stage dark-age)
    (set-goal gl-attack-status 0)
    (set-strategic-number sn-enable-new-building-system 1)
    (set-strategic-number sn-percent-building-cancellation 10)
    (set-strategic-number sn-cap-civilian-builders 8)
    (set-strategic-number sn-percent-civilian-builders 25)
    (set-strategic-number sn-placement-zone-size 3)
    (set-strategic-number sn-placement-fail-delta 1)
    (set-strategic-number sn-placement-to-center 1)
    (disable-self)
)

; --- Rule 2: Town Sizing, Dropsites, Buffer & Aesthetics ---
(defrule
    (true)
=>
    (set-strategic-number sn-minimum-town-size 10)
    (set-strategic-number sn-maximum-town-size 16)
    (set-strategic-number sn-safe-town-size 25)
    (set-strategic-number sn-food-dropsite-distance 4)
    (set-strategic-number sn-wood-dropsite-distance 4)
    (set-strategic-number sn-gold-dropsite-distance 4)
    (set-strategic-number sn-stone-dropsite-distance 4)
    (set-strategic-number sn-dropsite-separation-distance 10)
    (set-strategic-number sn-allow-adjacent-dropsites 0)
    (set-strategic-number sn-preferred-mill-placement 0)
    (set-strategic-number sn-minimum-dropsite-buffer 20)
    (disable-self)
)

; --- Rule 3: Camp Distances, Queuing & Anti-Civilian Explorer ---
(defrule
    (true)
=>
    (set-strategic-number sn-camp-max-distance 20)
    (set-strategic-number sn-mill-max-distance 20)
    (set-strategic-number sn-lumber-camp-max-distance 25)
    (set-strategic-number sn-mining-camp-max-distance 25)
    (set-strategic-number sn-enable-training-queue 2)
    (set-strategic-number sn-enable-research-queue 1)
    (set-strategic-number sn-total-number-explorers 1)
    (set-strategic-number sn-number-explore-groups 1)
    (set-strategic-number sn-cap-civilian-explorers 0)
    (set-strategic-number sn-percent-civilian-explorers 0)
    (set-strategic-number sn-minimum-civilian-explorers 0)
    (set-strategic-number sn-home-exploration-time 260)
    (disable-self)
)

; --- Rule 4: Dark Age Economy, Builders, Boar Hunting & Repair ---
(defrule
    (true)
=>
    (set-strategic-number sn-food-gatherer-percentage 65)
    (set-strategic-number sn-wood-gatherer-percentage 35)
    (set-strategic-number sn-gold-gatherer-percentage 0)
    (set-strategic-number sn-stone-gatherer-percentage 0)
    (set-strategic-number sn-percent-civilian-gatherers 75)
    (set-strategic-number sn-percent-civilian-builders 25)
    (set-strategic-number sn-cap-civilian-builders 16)
    (set-strategic-number sn-enable-boar-hunting 2)
    (set-strategic-number sn-minimum-boar-hunt-group-size 1)
    (set-strategic-number sn-minimum-number-hunters 6)
    (set-strategic-number sn-livestock-to-town-center 1)
    (set-strategic-number sn-object-repair-level 32767)
    (disable-self)
)

; --- Rule 5: Combat & Strategic Cooperation Intelligence ---
(defrule
    (true)
=>
    (set-strategic-number sn-enable-patrol-attack 1)
    (set-strategic-number sn-attack-intelligence 1)
    (set-strategic-number sn-gather-idle-soldiers-at-center 1)
    (set-strategic-number sn-gather-defense-units 1)
    (set-strategic-number sn-task-ungrouped-soldiers 1)
    (set-strategic-number sn-coop-share-information 1)
    (set-strategic-number sn-coop-share-attacking 1)
    (set-strategic-number sn-building-targeting-mode 1)
    (set-strategic-number sn-free-siege-targeting 0)
    (set-strategic-number sn-target-evaluation-siege-weapon 500)
    (set-strategic-number sn-target-evaluation-damage-capability 25)
    (set-strategic-number sn-target-evaluation-time-kill-ratio 50)
    (disable-self)
)

; --- Rule 6: Walls, Gates, Relics, Timers & Engine Greeting ---
(defrule
    (true)
=>
    (set-strategic-number sn-wall-targeting-mode 1)
    (set-strategic-number sn-gate-type-for-wall 1)
    (set-strategic-number sn-disable-builder-assistance 0)
    (set-strategic-number sn-relic-return-distance 500)
    (enable-wall-placement 2)
    (enable-timer gl-wave-timer 60)
    (enable-timer gl-macro-timer 15)
    (chat-to-all "ZULFIKAR: gl hf! Adaptive Universal Engine active.")
    (disable-self)
)

; Focus closest enemy
(defrule
    (game-time > 25)
=>
    (up-find-player enemy find-closest gl-target-player)
    (up-modify-sn sn-target-player-number g:= gl-target-player)
    (up-modify-sn sn-focus-player-number g:= gl-target-player)
)
; ============================================================
; SECTION 3: MAP GEOMETRY & STYLE ADAPTATION
; Detects whether the battlefield is Closed (Arena/BF),
; Water/Islands, Nomad, or Open, and tailors strategy instantly.
; ============================================================

; --- Detect Closed Maps (Arena, Fortress, Black Forest, Oasis) ---
(defrule
    (or (map-type arena)
    (or (map-type fortress)
    (or (map-type black-forest)
        (map-type oasis))))
=>
    (set-goal gl-map-style style-closed)
    (chat-local-to-self "ZULFIKAR: Closed Map detected -> Fast Castle & Boom focus.")
    (disable-self)
)

; --- Detect Water / Island Maps (Islands, Team Islands, Migration, Pacific Islands) ---
(defrule
    (or (map-type islands)
    (or (map-type team-islands)
    (or (map-type migration)
        (map-type pacific-islands))))
=>
    (set-goal gl-map-style style-water)
    (chat-local-to-self "ZULFIKAR: Water Map detected -> Naval dominance focus.")
    (disable-self)
)

; --- Detect Hybrid Maps (Rivers, Baltic, Coastal, Four Lakes) ---
(defrule
    (or (map-type rivers)
    (or (map-type coastal)
    (or (map-type four-lakes)
        (map-type baltic))))
=>
    (set-goal gl-map-style style-hybrid)
    (chat-local-to-self "ZULFIKAR: Hybrid Map detected -> Land & Naval balance.")
    (disable-self)
)

; --- Detect Nomad Maps (Nomad start: 0 TCs at start) ---
(defrule
    (current-age <= dark-age)
    (building-type-count-total town-center < 1)
=>
    (set-goal gl-map-style style-nomad)
    (chat-local-to-self "ZULFIKAR: Nomad start detected -> Immediate TC construction.")
    (disable-self)
)

; --- Nomad Execution: Build first Town Center ASAP ---
(defrule
    (goal gl-map-style style-nomad)
    (current-age <= dark-age)
    (building-type-count-total town-center < 1)
    (can-build town-center)
=>
    (build town-center)
)

; --- Regicide Game Mode (Protect King at all costs) ---
(defrule
    (regicide-game)
=>
    (set-strategic-number sn-number-garrison-units 1)
    (set-strategic-number sn-safe-town-size 40)
    (chat-to-all "ZULFIKAR: REGICIDE mode active. Long live the King!")
    (disable-self)
)

(defrule
    (regicide-game)
    (current-age >= castle-age)
    (can-build castle)
    (building-type-count-total castle < 3)
=>
    (build castle)
)

(defrule
    (regicide-game)
    (current-age >= castle-age)
    (can-build-wall 2 stone-wall-line)
=>
    (enable-wall-placement 2)
    (build-wall 2 stone-wall-line)
)

; --- Empire Wars Game Mode (Starts in Feudal Age at 0:00 with 27 villagers) ---
(defrule
    (game-time < 10)
    (current-age == feudal-age)
=>
    (set-goal gl-game-stage feudal-age)
    (set-strategic-number sn-percent-civilian-gatherers 80)
    (set-strategic-number sn-percent-civilian-builders 20)
    (set-strategic-number sn-cap-civilian-builders 16)
    (chat-to-all "ZULFIKAR: EMPIRE WARS mode detected! Instant combat active.")
    (disable-self)
)
; ============================================================
; SECTION 4: MAP SIZE ADAPTATION
; Adjusts dropsite distances, town size limits, and trade scaling
; based on map dimensions from Tiny (1v1) to Ludikris.
; ============================================================

; --- Small Maps (Tiny / Small / 2-3 players) ---
(defrule
    (or (map-size tiny)
        (map-size small))
=>
    (set-goal gl-map-size size-small)
    (set-strategic-number sn-maximum-town-size 22)
    (set-strategic-number sn-sentry-distance 12)
    (set-strategic-number sn-defense-distance 14)
    (disable-self)
)

; --- Large / Giant / Ludikris Maps (Massive Scale) ---
(defrule
    (or (map-size giant)
        (map-size ludikris))
=>
    (set-goal gl-map-size size-large)
    ; Scale exploration and camps outwards
    (set-strategic-number sn-camp-max-distance 35)
    (set-strategic-number sn-lumber-camp-max-distance 45)
    (set-strategic-number sn-mining-camp-max-distance 45)
    (set-strategic-number sn-home-exploration-time 450)
    (disable-self)
)

; Late-game town size expansion on Large/Ludikris maps to avoid building placement failure
(defrule
    (goal gl-map-size size-large)
    (current-age >= castle-age)
=>
    (set-strategic-number sn-maximum-town-size 85)
    (set-strategic-number sn-safe-town-size 65)
    (disable-self)
)

(defrule
    (goal gl-map-size size-large)
    (current-age >= imperial-age)
=>
    (set-strategic-number sn-maximum-town-size 130)
    (set-strategic-number sn-safe-town-size 90)
    (disable-self)
)
; ============================================================
; SECTION 5: COMPLETE 45-CIVILIZATION ARCHETYPE DETECTION
; Categorizes every civilization in Age of Empires II: Definitive Edition
; to play its signature tech tree, bonuses, and Castle unique units.
; ============================================================

; --- Cavalry Civs (Franks, Magyars, Berbers, Lithuanians, Huns, Teutons, Persians, Burgundians, Poles, Bulgarians, Cumans, Georgians) ---
(defrule
    (or (civ-selected frankish)
    (or (civ-selected magyar)
    (or (civ-selected berbers)
    (or (civ-selected lithuanians)
    (or (civ-selected hun)
    (or (civ-selected teutonic)
    (or (civ-selected persian)
    (or (civ-selected burgundians)
    (or (civ-selected poles)
    (or (civ-selected bulgarians)
    (or (civ-selected cumans)
        (civ-selected georgians))))))))))))
=>
    (set-goal gl-civ-archetype archetype-cavalry)
    (chat-local-to-self "ZULFIKAR: Archetype -> CAVALRY")
    (disable-self)
)

; --- Archer Civs (Britons, Mayans, Ethiopians, Vietnamese, Tatars, Koreans, Italians) ---
(defrule
    (or (civ-selected briton)
    (or (civ-selected mayan)
    (or (civ-selected ethiopian)
    (or (civ-selected vietnamese)
    (or (civ-selected tatars)
    (or (civ-selected korean)
        (civ-selected italian)))))))
=>
    (set-goal gl-civ-archetype archetype-archer)
    (chat-local-to-self "ZULFIKAR: Archetype -> ARCHER")
    (disable-self)
)

; --- Infantry / Siege Civs (Goths, Celts, Japanese, Romans, Vikings, Slavs, Malians, Armenians) ---
(defrule
    (or (civ-selected gothic)
    (or (civ-selected celtic)
    (or (civ-selected japanese)
    (or (civ-selected romans)
    (or (civ-selected viking)
    (or (civ-selected slavic)
    (or (civ-selected malian)
        (civ-selected armenians))))))))
=>
    (set-goal gl-civ-archetype archetype-infantry)
    (chat-local-to-self "ZULFIKAR: Archetype -> INFANTRY / SIEGE")
    (disable-self)
)

; --- Gunpowder Civs (Turks, Bohemians, Spanish, Portuguese, Hindustanis) ---
(defrule
    (or (civ-selected turkish)
    (or (civ-selected bohemians)
    (or (civ-selected spanish)
    (or (civ-selected portuguese)
        (civ-selected indian)))))
=>
    (set-goal gl-civ-archetype archetype-gunpowder)
    (chat-local-to-self "ZULFIKAR: Archetype -> GUNPOWDER")
    (disable-self)
)

; --- Mesoamerican Civs (Aztecs, Incas - No Stables! Eagle Warriors) ---
(defrule
    (or (civ-selected aztec)
        (civ-selected incan))
=>
    (set-goal gl-civ-archetype archetype-meso)
    (chat-local-to-self "ZULFIKAR: Archetype -> MESOAMERICAN (Eagle Warriors)")
    (disable-self)
)

; --- Camel / Counter Specialists (Saracens, Gurjaras, Berbers) ---
(defrule
    (or (civ-selected saracen)
        (civ-selected gurjaras))
=>
    (set-goal gl-civ-archetype archetype-camel)
    (chat-local-to-self "ZULFIKAR: Archetype -> CAMEL / DYNAMIC COUNTER")
    (disable-self)
)
; ============================================================
; SECTION 6: DYNAMIC REAL-TIME MACRO & MANPOWER ALLOCATION
; Continuously monitors resource inventory and reallocates gatherers
; dynamically like a high-ELO human player to eliminate shortages
; and floating resources.
; ============================================================

; ------------------------------------------------------------
; 1. DARK AGE MANPOWER (Opening Economy)
; ------------------------------------------------------------
(defrule
    (current-age <= dark-age)
    (food-amount < 480)
=>
    (set-strategic-number sn-food-gatherer-percentage 65)
    (set-strategic-number sn-wood-gatherer-percentage 35)
    (set-strategic-number sn-gold-gatherer-percentage 0)
    (set-strategic-number sn-stone-gatherer-percentage 0)
)

(defrule
    (current-age <= dark-age)
    (food-amount >= 480)
=>
    (set-strategic-number sn-food-gatherer-percentage 50)
    (set-strategic-number sn-wood-gatherer-percentage 50)
    (set-strategic-number sn-gold-gatherer-percentage 0)
    (set-strategic-number sn-stone-gatherer-percentage 0)
)

; ------------------------------------------------------------
; 2. FEUDAL AGE MANPOWER (Dynamic Priority Allocation)
; ------------------------------------------------------------
(defrule
    (current-age >= feudal-age)
    (current-age < castle-age)
    (wood-amount >= 100)
    (food-amount >= 150)
    (wood-amount <= 400)
=>
    (set-strategic-number sn-food-gatherer-percentage 45)
    (set-strategic-number sn-wood-gatherer-percentage 38)
    (set-strategic-number sn-gold-gatherer-percentage 17)
    (set-strategic-number sn-stone-gatherer-percentage 0)
)

(defrule
    (current-age >= feudal-age)
    (current-age < castle-age)
    (wood-amount < 100)
=>
    (set-strategic-number sn-wood-gatherer-percentage 55)
    (set-strategic-number sn-food-gatherer-percentage 32)
    (set-strategic-number sn-gold-gatherer-percentage 13)
    (set-strategic-number sn-stone-gatherer-percentage 0)
)

(defrule
    (current-age >= feudal-age)
    (current-age < castle-age)
    (food-amount < 150)
    (wood-amount >= 100)
=>
    (set-strategic-number sn-food-gatherer-percentage 56)
    (set-strategic-number sn-wood-gatherer-percentage 30)
    (set-strategic-number sn-gold-gatherer-percentage 14)
    (set-strategic-number sn-stone-gatherer-percentage 0)
)

(defrule
    (current-age >= feudal-age)
    (current-age < castle-age)
    (wood-amount >= 200)
    (building-type-count-total blacksmith >= 1)
    (or (food-amount < 800)
        (gold-amount < 200))
=>
    (set-strategic-number sn-food-gatherer-percentage 55)
    (set-strategic-number sn-gold-gatherer-percentage 25)
    (set-strategic-number sn-wood-gatherer-percentage 20)
    (set-strategic-number sn-stone-gatherer-percentage 0)
)

(defrule
    (current-age >= feudal-age)
    (current-age < castle-age)
    (wood-amount > 400)
=>
    (set-strategic-number sn-food-gatherer-percentage 60)
    (set-strategic-number sn-wood-gatherer-percentage 22)
    (set-strategic-number sn-gold-gatherer-percentage 18)
    (set-strategic-number sn-stone-gatherer-percentage 0)
)

; Feudal Stone Mining: Allocate stone gatherers once mining camp or blacksmith is established
(defrule
    (current-age >= feudal-age)
    (current-age < castle-age)
    (or (building-type-count-total mining-camp >= 2)
        (building-type-count-total blacksmith >= 1))
    (stone-amount < 650)
=>
    (set-strategic-number sn-food-gatherer-percentage 42)
    (set-strategic-number sn-wood-gatherer-percentage 28)
    (set-strategic-number sn-gold-gatherer-percentage 15)
    (set-strategic-number sn-stone-gatherer-percentage 15)
)

; ------------------------------------------------------------
; 3. CASTLE AGE MANPOWER (Boom, Stone Rush & Military Macro)
; ------------------------------------------------------------
(defrule
    (current-age >= castle-age)
    (current-age < imperial-age)
    (or (building-type-count-total castle >= 1)
        (stone-amount >= 650))
    (wood-amount >= 120)
    (food-amount >= 200)
    (wood-amount <= 600)
    (food-amount <= 900)
=>
    (set-strategic-number sn-food-gatherer-percentage 42)
    (set-strategic-number sn-wood-gatherer-percentage 30)
    (set-strategic-number sn-gold-gatherer-percentage 22)
    (set-strategic-number sn-stone-gatherer-percentage 6)
