; ============================================================
; ZULFIKAR - Age of Empires II: Definitive Edition AI
; Version: 3.5 (Universal Multi-Style Adaptation Engine)
; 
; Fully adaptive across:
; - Map Geometry: Open, Closed (Arena/BF), Water/Islands, Nomad
; - Map Size: Tiny (1v1) to Ludikris (Massive Scale)
; - Game Stage: Dark Opening -> Feudal -> 3-TC Boom -> Imp Deathball -> Trash War
; - Dynamic Macro: Real-Time Resource Bank Feedback & Reallocation
; - All 45 Civilizations & Castle Unique Units + Unique Techs
; - Tactical Counters, Cohesive Wave Warfare & 100% Fair Play
; ============================================================
; ============================================================
; SECTION 1: CONSTANTS & SYSTEM CONFIGURATION
; ============================================================

; --- Villager Population Caps ---
(defconst gl-dark-age-vils 21)
(defconst gl-feudal-age-vils 38)
(defconst gl-castle-age-vils 95)
(defconst gl-imperial-age-vils 135)

; --- Adaptation Goals & State Tracking ---
(defconst gl-map-style 1)          ; 1=Open, 2=Closed (Arena/BF), 3=Water, 4=Nomad
(defconst gl-map-size 2)           ; 1=Small, 2=Medium, 3=Large/Ludikris
(defconst gl-civ-archetype 3)      ; 1=Cavalry, 2=Archer, 3=Infantry, 4=Gunpowder, 5=Meso, 6=Camel, 7=Balanced
(defconst gl-game-stage 4)         ; 0=Dark, 1=Feudal, 2=Castle, 3=Imp, 4=TrashWar
(defconst gl-attack-status 5)      ; 0=Regrouping/Defending, 1=Attacking
(defconst gl-target-player 6)

; --- Timers ---
(defconst gl-wave-timer 1)         ; Attack wave pacing
(defconst gl-macro-timer 2)        ; Macro rebalancing timer
(defconst gl-scout-timer 3)        ; Exploration timer

