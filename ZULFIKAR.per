; ============================================================
; SECTION 13: COMBAT LOGIC, RETALIATION & COHESIVE ATTACKS
; ============================================================

; Feudal Harass (only on open maps when military advantage exists)
(defrule
    (goal gl-map-style style-open)
    (current-age >= feudal-age)
    (current-age < castle-age)
    (military-population >= 8)
    (timer-triggered gl-wave-timer)
    (not (town-under-attack))
=>
    (set-strategic-number sn-number-attack-groups 1)
    (set-strategic-number sn-minimum-attack-group-size 6)
    (set-strategic-number sn-maximum-attack-group-size 15)
    (set-strategic-number sn-percent-attack-soldiers 75)
    (set-goal gl-attack-status 1)
    (attack-now)
    (disable-timer gl-wave-timer)
    (enable-timer gl-wave-timer 60)
)

; Castle Age Wave Assault
(defrule
    (current-age >= castle-age)
    (current-age < imperial-age)
    (military-population >= 20)
    (timer-triggered gl-wave-timer)
    (not (town-under-attack))
=>
    (set-strategic-number sn-number-attack-groups 2)
    (set-strategic-number sn-minimum-attack-group-size 10)
    (set-strategic-number sn-maximum-attack-group-size 25)
    (set-strategic-number sn-percent-attack-soldiers 75)
    (set-goal gl-attack-status 1)
    (attack-now)
    (disable-timer gl-wave-timer)
    (enable-timer gl-wave-timer 60)
)

; Imperial Age Deathball Assault
(defrule
    (current-age >= imperial-age)
    (military-population >= 40)
    (timer-triggered gl-wave-timer)
    (not (town-under-attack))
=>
    (set-strategic-number sn-number-attack-groups 4)
    (set-strategic-number sn-minimum-attack-group-size 12)
    (set-strategic-number sn-maximum-attack-group-size 40)
    (set-strategic-number sn-percent-attack-soldiers 80)
    (set-goal gl-attack-status 1)
    (attack-now)
    (disable-timer gl-wave-timer)
    (enable-timer gl-wave-timer 60)
)

; --- THREAT-MATCHED DEFENSIVE INTERCEPTION MATRIX ---
; Instead of mindlessly rallying 100% of all troops to every raid,
; ZULFIKAR analyzes the threat type and dispatches the exact hard counter
; while maintaining reserves so it never falls for decoy raids.

; --- 1. MINOR HARASSMENT: Decoy / Small Raid (< 6 enemy military) ---
; Anti-Baiting: Deploy only an agile 4-8 unit counter squad, keeping main army in reserve!
(defrule
    (town-under-attack)
    (players-military-population any-enemy < 6)
    (military-population >= 4)
=>
    (set-strategic-number sn-number-attack-groups 1)
    (set-strategic-number sn-minimum-attack-group-size 3)
    (set-strategic-number sn-maximum-attack-group-size 8)
    (set-strategic-number sn-percent-attack-soldiers 40)
    (set-strategic-number sn-maximum-town-size 45)
    (attack-now)
)

; --- 2. THREAT: ENEMY CAVALRY RAID (Scouts / Knights / Camels) ---
; Dispatch anti-cavalry response: Spearmen/Pikemen/Halberdiers & Camels intercept
(defrule
    (town-under-attack)
    (or (players-unit-type-count any-enemy knight-line >= 1)
        (players-unit-type-count any-enemy scout-cavalry-line >= 1))
    (or (unit-type-count-total spearman-line >= 2)
        (unit-type-count-total camel-line >= 2))
=>
    (set-strategic-number sn-number-attack-groups 2)
    (set-strategic-number sn-minimum-attack-group-size 4)
    (set-strategic-number sn-maximum-attack-group-size 15)
    (set-strategic-number sn-percent-attack-soldiers 60)
    (set-strategic-number sn-maximum-town-size 50)
    (attack-now)
    (chat-local-to-self "ZULFIKAR: Cavalry raid! Intercepting with anti-cavalry.")
)

; --- 3. THREAT: ENEMY ARCHER / RANGED RAID ---
; Dispatch high pierce armor & skirmishers: Skirmishers, Knights, Mangonels
; (Keeps spearmen back from arrow slaughter)
(defrule
    (town-under-attack)
    (or (players-unit-type-count any-enemy archer-line >= 2)
        (players-unit-type-count any-enemy skirmisher-line >= 2))
    (or (unit-type-count-total skirmisher-line >= 2)
        (or (unit-type-count-total knight-line >= 2)
            (unit-type-count-total mangonel-line >= 1)))
=>
    (set-strategic-number sn-number-attack-groups 2)
    (set-strategic-number sn-minimum-attack-group-size 4)
    (set-strategic-number sn-maximum-attack-group-size 18)
    (set-strategic-number sn-percent-attack-soldiers 65)
    (set-strategic-number sn-maximum-town-size 50)
    (attack-now)
    (chat-local-to-self "ZULFIKAR: Archer raid! Deploying skirmishers and cavalry.")
)

; --- 4. THREAT: ENEMY SIEGE PUSH (Mangonels / Rams / Trebuchets) ---
; Priority: Mobile cavalry (Scouts, Knights, Hussars) flank and snipe siege weapons!
(defrule
    (town-under-attack)
    (or (players-unit-type-count any-enemy mangonel-line >= 1)
        (or (players-unit-type-count any-enemy battering-ram-line >= 1)
            (players-unit-type-count any-enemy trebuchet >= 1)))
    (or (unit-type-count-total scout-cavalry-line >= 2)
        (unit-type-count-total knight-line >= 2))
=>
    (set-strategic-number sn-number-attack-groups 2)
    (set-strategic-number sn-minimum-attack-group-size 4)
    (set-strategic-number sn-maximum-attack-group-size 15)
    (set-strategic-number sn-percent-attack-soldiers 70)
    (set-strategic-number sn-maximum-town-size 65)
    (attack-now)
    (chat-local-to-self "ZULFIKAR: Enemy siege detected! Cavalry charging siege engines!")
)

; --- 5. MAJOR INVASION / TOWN BREACH (Enemy army >= 6 entering base) ---
; Existential threat: Mobilize full fortress garrison to repel the assault!
(defrule
    (town-under-attack)
    (players-military-population any-enemy >= 6)
    (military-population >= 6)
=>
    (set-strategic-number sn-number-attack-groups 3)
    (set-strategic-number sn-minimum-attack-group-size 6)
    (set-strategic-number sn-maximum-attack-group-size 35)
    (set-strategic-number sn-percent-attack-soldiers 100)
    (set-strategic-number sn-maximum-town-size 70)
    (attack-now)
    (chat-to-all "ZULFIKAR: Citadel breached! Full fortress defense mobilized!")
)

; Regroup at fortress when army is low
(defrule
    (goal gl-attack-status 1)
    (current-age >= castle-age)
    (military-population < 10)
    (not (town-under-attack))
=>
    (set-strategic-number sn-number-attack-groups 0)
    (set-strategic-number sn-percent-attack-soldiers 0)
    (set-goal gl-attack-status 0)
    (up-retreat-now)
    (chat-local-to-self "ZULFIKAR: Forces depleted. Regrouping at fortress.")
)

; All-in rush on enemy Wonder
(defrule
    (players-building-type-count any-enemy wonder >= 1)
    (military-population >= 8)
=>
    (set-strategic-number sn-number-attack-groups 5)
    (set-strategic-number sn-minimum-attack-group-size 2)
    (set-strategic-number sn-maximum-attack-group-size 100)
    (set-strategic-number sn-percent-attack-soldiers 100)
    (chat-to-all "ZULFIKAR: Enemy Wonder sighted! All forces converge!")
    (attack-now)
)

; --- STRATEGIC BATTLE PLAN: ARROW-ABSORPTION VANGUARD ---
; When assaulting fortified enemy bases, Battering Rams lead the vanguard.
; With 180-195 pierce armor, Rams absorb lethal Castle and Town Center arrow fire,
; shielding squishy infantry, archers, and cavalry from being sacrificed.
(defrule
    (goal gl-attack-status 1)
    (or (players-building-type-count target-player castle >= 1)
        (players-building-type-count target-player town-center >= 1))
    (unit-type-count-total battering-ram-line >= 1)
=>
    (set-strategic-number sn-target-evaluation-siege-weapon 600)
    (set-strategic-number sn-target-evaluation-damage-capability 50)
    (set-strategic-number sn-target-evaluation-range 100)
    (chat-local-to-self "ZULFIKAR: Rams leading vanguard to absorb defensive arrow fire!")
)

; --- STRATEGIC BATTLE PLAN: STANDOFF SIEGE ANNIHILATION ---
; When encountering Castles or Bombard Towers, Trebuchets and Bombard Cannons engage from
; 12-16 standoff range. Main body provides protective escort rather than suicidal melee dives.
(defrule
    (current-age >= imperial-age)
    (or (players-building-type-count target-player castle >= 1)
        (players-building-type-count target-player bombard-tower >= 1))
    (or (unit-type-count-total trebuchet >= 2)
        (unit-type-count-total bombard-cannon >= 2))
=>
    (set-strategic-number sn-target-evaluation-siege-weapon 500)
    (set-strategic-number sn-target-evaluation-close-by 200)
    (set-strategic-number sn-target-evaluation-range 80)
    (chat-local-to-self "ZULFIKAR: Standoff siege deployed! Fortifications under siege.")
)

; --- STRATEGIC BATTLE PLAN: FRIENDLY FIRE AVOIDANCE ---
; Prohibits Mangonels/Onagers from firing blindly into friendly melee lines.
; Keeps friendly fire setting active across all battle phases.
(defrule
    (true)
=>
    (set-strategic-number sn-free-siege-targeting 0)
)

; --- STRATEGIC BATTLE PLAN: RELIC LIBERATION ASSAULT ---
; When an enemy captures relics, concentrate firepower to destroy their Monastery and liberate relics!
(defrule
    (current-age >= castle-age)
    (enemy-captured-relics)
    (players-building-type-count target-player monastery >= 1)
    (military-population >= 15)
=>
    (set-strategic-number sn-target-evaluation-damage-capability 100)
    (set-strategic-number sn-target-evaluation-range 120)
    (set-goal gl-attack-status 1)
    (attack-now)
    (chat-local-to-self "ZULFIKAR: Enemy holds relics! Assaulting enemy monastery to liberate them.")
)

; --- STRATEGIC BATTLE PLAN: POST-DEFEAT RELIC RECLAMATION SWEEP ---
; When an enemy resigns or is defeated, or dropped relics exist on the map (Player 0 Gaia):
; Dispatch fast scouts to illuminate enemy ruins and train Monks to retrieve all dropped relics!
(defrule
    (current-age >= castle-age)
    (or (player-resigned any-enemy)
        (or (players-building-count target-player == 0)
            (or (enemy-captured-relics)
                (cc-players-unit-type-count 0 relic > 0))))
    (building-type-count-total monastery >= 1)
    (unit-type-count-total monk < 4)
    (can-train monk)
=>
    (train monk)
    (set-strategic-number sn-relic-return-distance 500)
    (set-strategic-number sn-total-number-explorers 3)
    (set-strategic-number sn-number-explore-groups 2)
    (chat-local-to-self "ZULFIKAR: Enemy fallen / relics liberated! Monks and scouts sweeping map for relics.")
)

(defrule
    (current-age >= castle-age)
    (cc-players-unit-type-count 0 relic > 0)
    (building-type-count-total monastery >= 1)
    (unit-type-count-total monk >= 1)
=>
    (set-strategic-number sn-relic-return-distance 500)
)
; ============================================================
; SECTION 14: VILLAGER GARRISON & RAID SURVIVAL
; ============================================================

(defrule
    (town-under-attack)
    (building-type-count town-center >= 1)
=>
    (set-strategic-number sn-maximum-garrison-fill 15)
    (set-strategic-number sn-number-garrison-units 10)
    (set-strategic-number sn-disable-villager-garrison 0)
)

(defrule
    (not (town-under-attack))
    (strategic-number sn-number-garrison-units > 0)
=>
    (set-strategic-number sn-number-garrison-units 0)
)

(defrule
    (town-under-attack)
    (current-age <= feudal-age)
    (unit-type-count-total spearman-line < 6)
    (can-train spearman-line)
=>
    (train spearman-line)
)
; ============================================================
; SECTION 15: FAIR COMMERCE, ALLY TRADE & TRASH WARS
; 100% fair play. Market trading, team trade carts, and
; automatic transition to trash army when gold deposits deplete.
; ============================================================

; Trade Carts (scaled by map size in team games)
(defrule
    (current-age >= castle-age)
    (players-building-type-count any-ally market >= 1)
    (unit-type-count-total trade-cart < 15)
    (can-train trade-cart)
=>
    (train trade-cart)
)

(defrule
    (current-age >= imperial-age)
    (players-building-type-count any-ally market >= 1)
    (unit-type-count-total trade-cart < 28)
    (can-train trade-cart)
=>
    (train trade-cart)
)

(defrule
    (goal gl-map-size size-large)
    (current-age >= imperial-age)
    (players-building-type-count any-ally market >= 1)
    (unit-type-count-total trade-cart < 38)
    (can-train trade-cart)
=>
    (train trade-cart)
)

(defrule
    (can-research ri-caravan)
=>
    (research ri-caravan)
)

(defrule
    (can-research ri-coinage)
=>
    (research ri-coinage)
)

(defrule
    (can-research ri-banking)
=>
    (research ri-banking)
)

(defrule
    (can-research ri-guilds)
=>
    (research ri-guilds)
)

; Ally tributes
(defrule
    (current-age >= castle-age)
    (food-amount > 1600)
    (player-in-game any-ally)
    (players-civilian-population any-ally < 15)
=>
    (tribute-to-player any-ally food 250)
    (chat-to-player any-ally "ZULFIKAR: Relief food supplies dispatched!")
)

(defrule
    (current-age >= castle-age)
    (gold-amount > 1600)
    (player-in-game any-ally)
    (players-military-population any-ally < 8)
=>
    (tribute-to-player any-ally gold 200)
    (chat-to-player any-ally "ZULFIKAR: Gold dispatched to fund your military!")
)

; --- LATE GAME TRASH WAR (When Map Gold Depletes) ---
(defrule
    (current-age >= imperial-age)
    (gold-amount < 150)
    (unit-type-count-total trade-cart < 5)
=>
    (set-strategic-number sn-food-gatherer-percentage 50)
    (set-strategic-number sn-wood-gatherer-percentage 42)
    (set-strategic-number sn-gold-gatherer-percentage 5)
    (set-strategic-number sn-stone-gatherer-percentage 3)
)

(defrule
    (current-age >= imperial-age)
    (gold-amount < 150)
    (unit-type-count-total spearman-line < 35)
    (can-train spearman-line)
=>
    (train spearman-line)
)

(defrule
    (current-age >= imperial-age)
    (gold-amount < 150)
    (unit-type-count-total skirmisher-line < 25)
    (can-train skirmisher-line)
=>
    (train skirmisher-line)
)

(defrule
    (current-age >= imperial-age)
    (gold-amount < 150)
    (unit-type-count-total scout-cavalry-line < 20)
    (can-train scout-cavalry-line)
=>
    (train scout-cavalry-line)
)
; ============================================================
; ============================================================
; SECTION 16: UNIVERSAL NAVY & WATER DOMINANCE
; ============================================================

; Universal Dock 1: Founded on ANY map where shoreline is accessible
(defrule
    (building-type-count-total dock < 1)
    (can-build dock)
=>
    (build dock)
    (chat-local-to-self "ZULFIKAR: Waterway discovered! Dock founded.")
)

; Booming Fishery: Train fishing ships as soon as dock is founded
(defrule
    (building-type-count-total dock >= 1)
    (unit-type-count-total fishing-ship < 8)
    (can-train fishing-ship)
=>
    (train fishing-ship)
)

; Expansion Docks: Scale on water maps or when wood is plentiful
(defrule
    (current-age >= feudal-age)
    (or (goal gl-map-style style-water)
    (or (goal gl-map-style style-hybrid)
        (wood-amount > 350)))
    (building-type-count-total dock < 2)
    (can-build dock)
=>
    (build dock)
)

(defrule
    (current-age >= castle-age)
    (or (goal gl-map-style style-water)
    (or (goal gl-map-style style-hybrid)
        (wood-amount > 500)))
    (building-type-count-total dock < 4)
    (can-build dock)
=>
    (build dock)
)

; Feudal Warships: Fire galleys, galleys, demolition rafts
(defrule
    (current-age >= feudal-age)
    (building-type-count-total dock >= 1)
    (unit-type-count-total fire-ship-line < 6)
    (can-train fire-ship-line)
=>
    (train fire-ship-line)
)

(defrule
    (current-age >= feudal-age)
    (building-type-count-total dock >= 1)
    (unit-type-count-total galley-line < 6)
    (can-train galley-line)
=>
    (train galley-line)
)

(defrule
    (current-age >= feudal-age)
    (building-type-count-total dock >= 1)
    (unit-type-count-total demolition-ship-line < 3)
    (can-train demolition-ship-line)
=>
    (train demolition-ship-line)
)

; Castle & Imperial Warships: Heavy fleet composition
(defrule
    (current-age >= castle-age)
    (building-type-count-total dock >= 1)
    (unit-type-count-total fire-ship-line < 12)
    (can-train fire-ship-line)
=>
    (train fire-ship-line)
)

(defrule
    (current-age >= castle-age)
    (building-type-count-total dock >= 1)
    (unit-type-count-total galley-line < 15)
    (can-train galley-line)
=>
    (train galley-line)
)

(defrule
    (current-age >= castle-age)
    (building-type-count-total dock >= 1)
    (unit-type-count-total demolition-ship-line < 5)
    (can-train demolition-ship-line)
=>
    (train demolition-ship-line)
)

; --- NAVAL SIEGE WEAPONS: LONG-RANGE COASTAL ARTILLERY ---
; Cannon Galleons (13-15 range) for standard civilizations
(defrule
    (current-age >= imperial-age)
    (building-type-count-total dock >= 1)
    (unit-type-count-total cannon-galleon-line < 6)
    (can-train cannon-galleon-line)
=>
    (train cannon-galleon-line)
)

; Dromons (Greek fire catapult siege ships for Romans, Byzantines, Huns, Goths)
(defrule
    (current-age >= imperial-age)
    (building-type-count-total dock >= 1)
    (unit-type-count-total dromon < 6)
    (can-train dromon)
=>
    (train dromon)
)

; Demolition Ships (Naval Suicide Siege weapon vs packed enemy war fleets)
(defrule
    (current-age >= castle-age)
    (building-type-count-total dock >= 1)
    (unit-type-count-total demolition-ship-line < 6)
    (can-train demolition-ship-line)
=>
    (train demolition-ship-line)
)

; --- COHESIVE NAVAL BATTLE PLAN & COASTAL SIEGE ENGAGEMENT ---

; 1. Feudal Shore Patrol & Harass
(defrule
    (current-age >= feudal-age)
    (current-age < castle-age)
    (building-type-count-total dock >= 1)
    (or (unit-type-count-total fire-ship-line >= 4)
        (unit-type-count-total galley-line >= 5))
=>
    (set-strategic-number sn-number-boat-attack-groups 1)
    (set-strategic-number sn-minimum-boat-attack-group-size 3)
    (set-strategic-number sn-maximum-boat-attack-group-size 10)
    (set-strategic-number sn-percent-attack-boats 75)
    (set-strategic-number sn-target-evaluation-boat 100)
    (attack-now)
)

; 2. Castle Age Fleet Dominance & Dock Raiding
(defrule
    (current-age >= castle-age)
    (current-age < imperial-age)
    (building-type-count-total dock >= 1)
    (or (unit-type-count-total fire-ship-line >= 8)
        (unit-type-count-total galley-line >= 10))
=>
    (set-strategic-number sn-number-boat-attack-groups 2)
    (set-strategic-number sn-minimum-boat-attack-group-size 6)
    (set-strategic-number sn-maximum-boat-attack-group-size 22)
    (set-strategic-number sn-percent-attack-boats 85)
    (set-strategic-number sn-target-evaluation-boat 120)
    (attack-now)
)

; 3. Imperial Coastal Siege Bombardment (Cannon Galleons / Dromons + Screen)
(defrule
    (current-age >= imperial-age)
    (building-type-count-total dock >= 1)
    (or (unit-type-count-total cannon-galleon-line >= 2)
        (or (unit-type-count-total dromon >= 2)
            (or (unit-type-count-total fire-ship-line >= 10)
                (unit-type-count-total galley-line >= 12))))
=>
    (set-strategic-number sn-number-boat-attack-groups 3)
    (set-strategic-number sn-minimum-boat-attack-group-size 8)
    (set-strategic-number sn-maximum-boat-attack-group-size 35)
    (set-strategic-number sn-percent-attack-boats 100)
    (set-strategic-number sn-target-evaluation-boat 150)
    (set-strategic-number sn-target-evaluation-siege-weapon 500)
    (attack-now)
    (chat-local-to-self "ZULFIKAR: Naval siege fleet advancing! Coastal bombardment initiated.")
)

; 4. Defensive Fleet Scramble: Intercept enemy warships threatening our shoreline
(defrule
    (town-under-attack)
    (building-type-count-total dock >= 1)
    (players-unit-type-count any-enemy galley-line >= 1)
    (or (unit-type-count-total fire-ship-line >= 2)
        (unit-type-count-total galley-line >= 2))
=>
    (set-strategic-number sn-number-boat-attack-groups 2)
    (set-strategic-number sn-minimum-boat-attack-group-size 2)
    (set-strategic-number sn-maximum-boat-attack-group-size 25)
    (set-strategic-number sn-percent-attack-boats 100)
    (set-strategic-number sn-target-evaluation-boat 200)
    (attack-now)
    (chat-local-to-self "ZULFIKAR: Shoreline contested! Fleet scrambling to intercept enemy warships.")
)

; Transport Ships for ground invasion on water/islands
(defrule
    (goal gl-map-style style-water)
    (current-age >= castle-age)
    (building-type-count-total dock >= 1)
    (unit-type-count-total transport-ship < 2)
    (can-train transport-ship)
=>
    (train transport-ship)
)

; Water Trade Cogs for Allied Naval Trade
(defrule
    (player-in-game any-ally)
    (building-type-count-total dock >= 1)
    (unit-type-count-total trade-cog < 15)
    (can-train trade-cog)
=>
    (train trade-cog)
)

