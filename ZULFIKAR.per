    (chat-local-to-self "ZULFIKAR: Countering enemy siege with long-range Bombard Cannons.")
)

; Fortification Demolition (16-range standoff destruction vs Castles/Wonders)
(defrule
    (current-age >= imperial-age)
    (or (players-building-type-count target-player castle >= 1)
        (or (players-building-type-count target-player bombard-tower >= 1)
            (players-building-type-count target-player wonder >= 1)))
    (unit-type-count-total trebuchet < 5)
    (can-train trebuchet)
=>
    (train trebuchet)
)

