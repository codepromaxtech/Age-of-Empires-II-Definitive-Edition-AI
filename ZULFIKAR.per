(defconst style-open 1)
(defconst style-closed 2)
(defconst style-water 3)
(defconst style-nomad 4)
(defconst style-hybrid 5)

; --- Map Size Enums ---
(defconst size-small 1)
(defconst size-medium 2)
(defconst size-large 3)

